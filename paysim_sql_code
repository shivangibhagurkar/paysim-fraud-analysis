create database paysim_fraud;
use paysim_fraud;

select * from paysim_fraud;

-- Q1 : UPDATED SYSTEM FAILURE ANALYSIS

SELECT
    detection_method,
    flags_raised,
    true_positives,
    ROUND(true_positives / flags_raised * 100, 2)             AS precision_pct,
    ROUND(true_positives / (SELECT SUM(isFraud) FROM paysim_fraud) * 100, 2)
                                                               AS recall_pct
FROM (
    -- Existing system
    SELECT
        'Existing: isFlaggedFraud'                AS detection_method,
        SUM(isFlaggedFraud)                     AS flags_raised,
        SUM(isFlaggedFraud & isFraud)          AS true_positives
    FROM paysim_fraud

    UNION ALL

    -- Our model: Critical tier (Score >= 75)
    SELECT
        'Our Model: Critical Tier (Score 75+)',
        COUNT(*),
        SUM(isFraud)
    FROM paysim_fraud
    WHERE risk_tier = 'Critical'

    UNION ALL

    -- Our model: High + Critical combined (Score >= 40)
    SELECT
        'Our Model: High + Critical Tiers (Score 40+)',
        COUNT(*),
        SUM(isFraud)
    FROM paysim_fraud
    WHERE risk_tier IN ('Critical', 'High')

) comparison_table
ORDER BY recall_pct DESC;

